# Copy this file to ignored root .env for disposable PostgreSQL.
# Export it only in the backend/setup shell. Frontend needs only optional API_BASE_URL.
# Server-only local FastAPI origin. Phase 01A accepts loopback HTTP origins only.
API_BASE_URL=http://127.0.0.1:8000
# Health/chat shell need no DB. Academic modules need the explicit V2 setup below.

# Phase 02C/02D: disposable local V2 PostgreSQL only. No API startup usage.
# Generate three different local passwords. Never commit the filled-in .env.
V2_POSTGRES_PASSWORD=REPLACE_LOCAL_ADMIN_PASSWORD
V2_MIGRATION_PASSWORD=REPLACE_LOCAL_MIGRATION_PASSWORD
V2_RUNTIME_PASSWORD=REPLACE_LOCAL_RUNTIME_PASSWORD
V2_BOOTSTRAP_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_LOCAL_ADMIN_PASSWORD@127.0.0.1:55432/cuny_advisor_v2_dev
V2_MIGRATION_DATABASE_URL=postgresql+psycopg://v2_migrator:REPLACE_LOCAL_MIGRATION_PASSWORD@127.0.0.1:55432/cuny_advisor_v2_dev
V2_DATABASE_URL=postgresql+psycopg://v2_runtime:REPLACE_LOCAL_RUNTIME_PASSWORD@127.0.0.1:55432/cuny_advisor_v2_dev
